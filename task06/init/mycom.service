[Unit]
Description=UART echo server (mycom) on /dev/ttyAMA0

After=sysinit.target dev-ttyAMA0.device
BindsTo=dev-ttyAMA0.device

Conflicts=serial-getty@ttyAMA0.service
After=serial-getty@ttyAMA0.service

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/mycom /dev/ttyAMA0

LogsDirectory=mycom
WorkingDirectory=/var/log/mycom

Restart=on-failure
RestartSec=2

KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
